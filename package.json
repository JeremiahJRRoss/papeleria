{
  "name": "papeleria",
  "version": "0.1.0",
  "description": "A folder of text, data and images becomes a finished deck, comic or printable document.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "papeleria": "lib/src/cli/index.js"
  },
  "files": [
    "lib/src/",
    "lib/templates/",
    "!lib/templates/*/client/",
    "lib/clients/",
    "!lib/**/*.map",
    "templates/",
    "theme/",
    "!theme/js/",
    "vendor/",
    "LICENSE",
    "NOTICE.md",
    "TRADEMARKS.md",
    "THIRD_PARTY.md",
    "licenses/",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/bundle-clients.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.browser-test.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"lib/test/**/*.test.js\"",
    "check:licenses": "node scripts/license-check.mjs",
    "check:licenses:release": "node scripts/license-check.mjs --release",
    "prepack": "node scripts/shrinkwrap.mjs",
    "postpack": "node scripts/shrinkwrap.mjs --remove",
    "prepublishOnly": "npm run check:licenses:release",
    "check:brand": "node scripts/brand-check.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "check:schema-defs": "node scripts/check-schema-defs.mjs",
    "check:brand-overview-content": "node scripts/check-brand-overview-content.mjs",
    "vendor:page-flip": "node scripts/vendor-page-flip.mjs",
    "gen:sample-comic": "npm run build && node scripts/gen-sample-comic.mjs",
    "gen:manifest-reference": "npm run build && node scripts/gen-manifest-reference.mjs",
    "pretest:browser": "npm run build && tsc -p tsconfig.browser-test.json",
    "test:browser": "node --test --test-concurrency=1 \"lib/browser-tests/test/browser/**/*.test.js\"",
    "pretest:package": "npm run build",
    "test:package": "node --test lib/test/package/tarball.js",
    "preexamples": "npm run build",
    "examples": "node scripts/build-examples.mjs",
    "package:installers": "npm run build && node scripts/package-installers.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/common": "^1",
    "@lezer/highlight": "^1",
    "ajv": "^8",
    "ajv-formats": "^3",
    "codemirror": "^6",
    "codemirror-json-schema": "^0.8.1",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "html-validate": "^11",
    "markdown-it": "^15",
    "markdown-it-footnote": "^4",
    "music-metadata": "^11.16.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/d3-array": "^3",
    "@types/d3-dsv": "^3",
    "@types/d3-format": "^3",
    "@types/d3-scale": "^4",
    "@types/d3-shape": "^3",
    "@types/d3-time-format": "^4",
    "@types/markdown-it-footnote": "^3",
    "@types/node": "^22",
    "esbuild": "^0.28",
    "playwright": "^1",
    "typescript": "^7"
  }
}
