    {"def": "text_value", "value": "assets/text/sub\\notes.md", "valid": false, "note": "no backslash"},
    {"def": "text_value", "value": "See assets/text/notes.md for the long version.", "valid": true, "note": "prose that mentions a path is not a file reference"},
    {"def": "text_value", "value": "assets/text/ holds the long notes, one file each", "valid": true, "note": "not a file reference: it does not end in .md"},

    {"def": "image_block", "value": {"src": "assets/images/pier.jpg", "alt": "The pier at dawn."}, "valid": true},
