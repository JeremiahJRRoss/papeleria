    {"def": "swatch", "value": {"name": "Process cyan", "value": "cyan"}, "valid": false},
    {"def": "column", "value": {"heading": "Before", "text": "assets/text/before.md"}, "valid": true},
    {"def": "column", "value": {"heading": "Before"}, "valid": false},

    {"def": "table_column", "value": "phase", "valid": true},
