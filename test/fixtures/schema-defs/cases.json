{
  "$comment": "Validation cases for templates/shared/schema-defs.json. Each case names a definition, a value and whether it must validate. Run with: node scripts/check-schema-defs.mjs",
  "cases": [
    {"def": "non_empty_string", "value": "A title", "valid": true},
    {"def": "non_empty_string", "value": "", "valid": false, "note": "empty"},
    {"def": "non_empty_string", "value": "   ", "valid": false, "note": "spaces only"},
    {"def": "non_empty_string", "value": "\t\n  ", "valid": false, "note": "tabs and newlines only"},
    {"def": "non_empty_string", "value": " x ", "valid": true, "note": "padded but not blank"},
    {"def": "non_empty_string", "value": 5, "valid": false, "note": "not a string"},
    {"def": "non_empty_string", "value": "\u200b", "valid": false, "note": "a zero-width space is not whitespace, and still shows nothing"},
    {"def": "non_empty_string", "value": "\u2060\u00ad\ufeff", "valid": false, "note": "a word joiner, a soft hyphen and a byte-order mark show nothing"},
    {"def": "non_empty_string", "value": "\u3164\uffa0\u115f\u1160", "valid": false, "note": "Hangul fillers print as blank space"},
    {"def": "non_empty_string", "value": "\u2800", "valid": false, "note": "the blank Braille pattern has no dots"},
    {"def": "non_empty_string", "value": "\u0001", "valid": false, "note": "a control character is not text"},
    {"def": "non_empty_string", "value": " \u200b\t\u00a0\u200d", "valid": false, "note": "spaces and invisible characters together are still blank"},
    {"def": "non_empty_string", "value": "a\u200b", "valid": true, "note": "one visible character is enough"},
    {"def": "non_empty_string", "value": "\u05e9\u05dc\u05d5\u05dd", "valid": true, "note": "right-to-left letters are visible"},
    {"def": "non_empty_string", "value": "\ud83d\ude00", "valid": true, "note": "an emoji is visible"},

    {"def": "title", "value": "Brand overview", "valid": true},
    {"def": "title", "value": " ", "valid": false, "note": "IC01: a blank title is a missing title"},
    {"def": "transcript", "value": "  ", "valid": false},
    {"def": "summary", "value": "   ", "valid": false},
    {"def": "heading", "value": "\u00a0", "valid": false, "note": "a heading of nothing but a non-breaking space is visually blank, and ECMAScript \\s covers U+00A0"},

    {"def": "schema_version", "value": 1, "valid": true},
    {"def": "schema_version", "value": 2, "valid": true, "note": "the template schema pins 1; a larger integer is the newer-schema error, not a type error"},
    {"def": "schema_version", "value": 0, "valid": false},
    {"def": "schema_version", "value": 1.5, "valid": false},
    {"def": "schema_version", "value": "1", "valid": false},

    {"def": "template_name", "value": "deck", "valid": true},
    {"def": "template_name", "value": "comic", "valid": true},
    {"def": "template_name", "value": "document", "valid": true},
    {"def": "template_name", "value": "slides", "valid": false},
    {"def": "language", "value": "es", "valid": true},
    {"def": "language", "value": "fr", "valid": false},
    {"def": "status", "value": "withheld", "valid": true},
    {"def": "status", "value": "final", "valid": false},

    {"def": "credit", "value": {"role": "Art", "name": "J. Ross"}, "valid": true},
    {"def": "credit", "value": {"role": "Art"}, "valid": false, "note": "name is required"},
    {"def": "credit", "value": {"role": "Art", "name": " "}, "valid": false},
    {"def": "credit", "value": {"role": "Art", "name": "J. Ross", "email": "x@y.z"}, "valid": false, "note": "no extra keys"},
    {"def": "credits", "value": [{"role": "Author", "name": "JR"}], "valid": true},

    {"def": "text_file_path", "value": "assets/text/summary.md", "valid": true},
    {"def": "text_file_path", "value": "assets/text/chapter/one.md", "valid": true},
    {"def": "text_file_path", "value": "assets/text/../../etc/passwd.md", "valid": false, "note": "traversal"},
    {"def": "text_file_path", "value": "/assets/text/summary.md", "valid": false, "note": "root absolute"},
    {"def": "text_file_path", "value": "C:/assets/text/summary.md", "valid": false, "note": "drive letter"},
    {"def": "text_file_path", "value": "assets\\text\\summary.md", "valid": false, "note": "backslashes"},
    {"def": "text_file_path", "value": "assets/text/summary.txt", "valid": false, "note": "wrong extension"},
    {"def": "text_file_path", "value": "assets/text/.hidden.md", "valid": false, "note": "dot segment"},

    {"def": "image_path", "value": "assets/images/pier.jpg", "valid": true},
    {"def": "image_path", "value": "assets/images/pages/page-01.png", "valid": true},
    {"def": "image_path", "value": "assets/images/mark.svg", "valid": true},
    {"def": "image_path", "value": "assets/images/photo.gif", "valid": false},
    {"def": "image_path", "value": "https://example.com/pier.jpg", "valid": false, "note": "no remote images"},
    {"def": "logo_path", "value": "assets/images/logos/client.svg", "valid": true},
    {"def": "logo_path", "value": "assets/images/client.svg", "valid": false, "note": "logos live in their own folder"},
    {"def": "data_path", "value": "assets/data/hours-by-phase.csv", "valid": true},
    {"def": "data_path", "value": "assets/data/2026/hours.csv", "valid": false, "note": "CSV files are not nested"},
    {"def": "video_path", "value": "assets/video/loop.webm", "valid": true},
    {"def": "video_path", "value": "assets/video/loop.mov", "valid": false},

    {"def": "hex_color", "value": "#2f7fbf", "valid": true},
    {"def": "hex_color", "value": "#abc", "valid": true},
    {"def": "hex_color", "value": "2f7fbf", "valid": false},
    {"def": "hex_color", "value": "rebeccapurple", "valid": false},

    {"def": "focal_point", "value": [50, 50], "valid": true},
    {"def": "focal_point", "value": [0, 100], "valid": true},
    {"def": "focal_point", "value": [50], "valid": false, "note": "needs both"},
    {"def": "focal_point", "value": [50, 50, 50], "valid": false, "note": "exactly two"},
    {"def": "focal_point", "value": [-1, 50], "valid": false},
    {"def": "focal_point", "value": [50, 101], "valid": false},

    {"def": "panel_box", "value": [0, 0, 100, 100], "valid": true, "note": "the whole page"},
    {"def": "panel_box", "value": [10.5, 20, 30, 40], "valid": true},
    {"def": "panel_box", "value": [0, 0, 0, 40], "valid": false, "note": "zero width"},
    {"def": "panel_box", "value": [0, 0, 40, 0], "valid": false, "note": "zero height"},
    {"def": "panel_box", "value": [0, 0, -10, 40], "valid": false, "note": "negative width"},
    {"def": "panel_box", "value": [-1, 0, 40, 40], "valid": false, "note": "x outside the page"},
    {"def": "panel_box", "value": [0, 0, 101, 40], "valid": false, "note": "wider than the page"},
    {"def": "panel_box", "value": [0, 0, 40], "valid": false, "note": "needs four numbers"},
    {"def": "panel_box", "value": [0, 0, 40, 40, 40], "valid": false, "note": "exactly four"},
    {"def": "panel_box", "value": [90, 0, 40, 40], "valid": true, "note": "x + width is 130: the extent rule is R14, not the schema"},
    {"def": "panel_box", "value": ["0", 0, 40, 40], "valid": false, "note": "numbers, not strings"},

    {"def": "detail", "value": {"zoom": true}, "valid": true},
    {"def": "detail", "value": {"text": "A closer look."}, "valid": true},
    {"def": "detail", "value": {"image": {"src": "assets/images/inset.png", "alt": "An inset."}}, "valid": true},
    {"def": "detail", "value": {"href": "https://example.com/source", "label": "The source"}, "valid": true},
    {"def": "detail", "value": {"href": "#page-3", "label": "Page three"}, "valid": true},
    {"def": "detail", "value": {"href": "notes.html", "label": "Notes"}, "valid": true},
    {"def": "detail", "value": {}, "valid": false, "note": "the union rejects zero keys"},
    {"def": "detail", "value": {"zoom": true, "text": "Both"}, "valid": false, "note": "the union rejects two keys"},
    {"def": "detail", "value": {"text": "a", "href": "https://example.com", "label": "x"}, "valid": false, "note": "two keys again"},
    {"def": "detail", "value": {"href": "https://example.com/source"}, "valid": false, "note": "href needs a label"},
    {"def": "detail", "value": {"zoom": true, "label": "Orphan"}, "valid": false, "note": "a label without href"},
    {"def": "detail", "value": {"zoom": false}, "valid": false, "note": "zoom is only ever true"},
    {"def": "detail", "value": {"href": "javascript:alert(1)", "label": "x"}, "valid": false, "note": "IC02 refuses this scheme"},
    {"def": "detail", "value": {"href": "data:text/html,<script>", "label": "x"}, "valid": false},
    {"def": "detail", "value": {"href": "file:///etc/passwd", "label": "x"}, "valid": false},
    {"def": "detail", "value": {"href": "//evil.example.com", "label": "x"}, "valid": false, "note": "protocol relative"},
    {"def": "detail_href", "value": "\\\\evil.example.com", "valid": false, "note": "a browser reads a backslash as a slash, so this is protocol relative too (D151)"},
    {"def": "detail_href", "value": "/\\evil.example.com", "valid": false, "note": "protocol relative, slash then backslash"},
    {"def": "detail_href", "value": "\\/evil.example.com", "valid": false, "note": "protocol relative, backslash then slash"},
    {"def": "detail_href", "value": "notes/page.html", "valid": true, "note": "a relative target with one slash inside it"},
    {"def": "detail_href", "value": "/timetable", "valid": false, "note": "an address from the root of the site breaks when the piece opens from disk (D151)"},
    {"def": "detail_href", "value": "\\timetable", "valid": false, "note": "a backslash is read as a slash, so this is from the root too"},
    {"def": "detail", "value": {"href": "mailto:hello@example.com", "label": "Write"}, "valid": true},
    {"def": "detail", "value": {"href": "tel:+15550100", "label": "Call"}, "valid": true},

    {"def": "panel", "value": {"box": [0, 0, 50, 50], "transcript": "She looks up."}, "valid": true},
    {"def": "panel", "value": {"box": [0, 0, 50, 50], "transcript": "  "}, "valid": false},
    {"def": "panel", "value": {"box": [0, 0, 50, 50]}, "valid": false, "note": "transcript is required"},
    {"def": "panel", "value": {"transcript": "She looks up."}, "valid": false, "note": "box is required"},
    {"def": "panel", "value": {"box": [0, 0, 50, 50], "transcript": "x", "detail": {"zoom": true}}, "valid": true},
    {"def": "panel", "value": {"box": [0, 0, 50, 50], "transcript": "x", "detail": {}}, "valid": false},

    {"def": "metadata_item", "value": {"label": "Owner", "value": "JR"}, "valid": true},
