{
  "name": "Papeleria theme",
  "version": "1.1.0",
  "status": "review",
  "provenance": "Generated from theme/css/tokens.css, which is the single source of truth. Adapted from the Ross.moda design language kit, authored by JR (Jeremiah Ross). Process colours were sampled from that kit's master mark, which is not included.",
  "cssCustomProperties": {
    "--process-cyan": "#32bce9",
    "--process-magenta": "#eb3a96",
    "--process-yellow": "#f5ee2f",
    "--process-key": "#050708",
    "--neutral-0": "#ffffff",
    "--neutral-25": "#fcfcfa",
    "--neutral-50": "#f7f7f3",
    "--neutral-100": "#efefeb",
    "--neutral-150": "#e5e5df",
    "--neutral-200": "#d8d8d1",
    "--neutral-300": "#c1c1b9",
    "--neutral-400": "#9f9f96",
    "--neutral-500": "#7c7c73",
    "--neutral-600": "#5f5f57",
    "--neutral-700": "#45453f",
    "--neutral-800": "#2e2e2a",
    "--neutral-900": "#1d1d1a",
    "--neutral-paper": "#fcfcfa",
    "--neutral-surface": "#ffffff",
    "--neutral-ink": "#1d1d1a",
    "--neutral-muted": "#5f5f57",
    "--neutral-rule": "#d8d8d1",
    "--brand-studio": "#32bce9",
    "--brand-deep": "#11110f",
    "--brand-light": "#e7f6fc",
    "--color-section-c": "var(--process-cyan)",
    "--color-section-m": "var(--process-magenta)",
    "--color-section-y": "var(--process-yellow)",
    "--color-section-k": "var(--process-key)",
    "--semantic-info": "#1f5e8c",
    "--semantic-success": "#1f6b45",
    "--semantic-warning": "#725000",
    "--semantic-error": "#9b2335",
    "--semantic-focus": "#005fcc",
    "--semantic-focus-reverse": "#ffe08a",
    "--color-ground": "var(--neutral-paper)",
    "--color-surface": "var(--neutral-surface)",
    "--color-text": "var(--neutral-ink)",
    "--color-text-muted": "var(--neutral-muted)",
    "--color-rule": "var(--neutral-rule)",
    "--color-brand": "var(--brand-studio)",
    "--color-opening": "var(--brand-deep)",
    "--color-inverse": "var(--neutral-surface)",
    "--font-display": "'Poppins','Montserrat','Avenir Next','Century Gothic','Helvetica Neue',Helvetica,Arial,sans-serif",
    "--font-reading": "'Inter','Helvetica Neue',Helvetica,Arial,'Liberation Sans',sans-serif",
    "--font-ui": "'Inter','Helvetica Neue',Helvetica,Arial,'Liberation Sans',sans-serif",
    "--font-mono": "ui-monospace,SFMono-Regular,Consolas,monospace",
    "--type-meta": ".75rem",
    "--type-small": ".9375rem",
    "--type-body": "1.125rem",
    "--type-lead": "1.375rem",
    "--type-h3": "1.5rem",
    "--type-h2": "clamp(1.75rem,2.6vw,2.25rem)",
    "--type-h1": "clamp(2.25rem,4.5vw,3.5rem)",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--space-6": "32px",
    "--space-7": "48px",
    "--space-8": "64px",
    "--space-9": "88px",
    "--space-10": "96px",
    "--grid-max": "1360px",
    "--grid-reading": "68ch",
    "--grid-gutter": "24px",
    "--grid-margin": "clamp(20px,4vw,64px)",
    "--rule-thin": "1px",
    "--rule-boundary": "2px",
    "--radius-control": "4px",
    "--radius-record": "0",
    "--button-primary-background": "var(--color-opening)",
    "--button-primary-text": "var(--color-inverse)",
    "--motion-fast": "160ms",
    "--focus-outline": "3px solid var(--semantic-focus)",
    "--slide-margin": "5%",
    "--print-safe": "18mm"
