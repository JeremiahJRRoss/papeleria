{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "lib",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "templates/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "lib",
    "**/dist",
    "examples",
    "reference",
    "theme",
    "templates/*/client/**",
    "templates/shared/preview-bridge.ts",
    "src/editor/**",
    "test/browser/**"
  ]
}
